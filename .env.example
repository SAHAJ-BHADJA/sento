# ---- Sento environment ----
# Copy to .env and fill in. Nothing here is required to build; the engine
# degrades gracefully (features that need a key report "unavailable").

# Postgres connection string (local or hosted: Neon, Supabase, Railway...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sento?schema=public"

# Auth (NextAuth). Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-please"
NEXTAUTH_URL="http://localhost:3000"

# Tailoring provider. Configure Anthropic OR an OpenAI-compatible endpoint.
# Anthropic (paid):
ANTHROPIC_API_KEY=""
SENTO_MODEL="claude-opus-4-8"
# OR a free/open OpenAI-compatible endpoint (Groq, Ollama, OpenRouter, Gemini).
# Examples:
#   Groq:   SENTO_LLM_BASE_URL=https://api.groq.com/openai/v1  SENTO_LLM_MODEL=llama-3.3-70b-versatile  SENTO_LLM_API_KEY=gsk_...
#   Ollama: SENTO_LLM_BASE_URL=http://localhost:11434/v1       SENTO_LLM_MODEL=llama3.1                  (no key)
SENTO_LLM_BASE_URL=""
SENTO_LLM_MODEL=""
SENTO_LLM_API_KEY=""

# Stripe — credit/billing tiers. Use test keys (sk_test_...).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_POWER=""

# Engine tuning
# How often the discovery worker polls ATS boards, in seconds.
SENTO_POLL_INTERVAL_SECONDS="900"
# Minimum match score (0-100) before an application is auto-prepared.
SENTO_MATCH_THRESHOLD="70"
# Set to "1" to require human approval before every submit (recommended while testing).
SENTO_REQUIRE_APPROVAL="1"
# Run the submission browser with a visible window (good for debugging / CAPTCHA handoff).
SENTO_HEADFUL="0"
